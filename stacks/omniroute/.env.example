# Official AMD64 image pinned by immutable repository digest.
OMNIROUTE_IMAGE=docker.io/diegosouzapw/omniroute@sha256:badb560971fdc23c2fb84b3e8695116239ff215b4cca4b07076201a8efae7f0d

# Generate independent values with: openssl rand -hex 32
JWT_SECRET=replace-with-64-hex-characters
API_KEY_SECRET=replace-with-64-hex-characters
STORAGE_ENCRYPTION_KEY=replace-with-64-hex-characters

# Bootstrap credential. Change it in OmniRoute after the first login.
INITIAL_PASSWORD=replace-with-a-long-unique-password

# Conservative profile for docker01.
OMNIROUTE_MEMORY_MB=768
